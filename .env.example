# Required only for the LLM agent (mode=llm). The deterministic agent (mode=rules) needs no key.
ANTHROPIC_API_KEY=

# Model used by the LLM agent
AGENT_MODEL=claude-opus-5

# Where the SQLite database lives (created + seeded automatically)
DATABASE_PATH=data/purchasing.db

# Autonomy policy: POs above this value (USD) require human approval
AUTO_APPROVE_MAX_PO_VALUE=5000

# Max propose -> validate -> revise iterations before the agent must escalate
MAX_REVISIONS=3
